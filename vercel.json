{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.curivanta.com"
        }
      ],
      "destination": "https://curivanta.com/:path*",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "https://link.curivanta.com/widget/bookings/solar-consulting-calendar",
      "permanent": false
    },
    {
      "source": "/widget/:path*",
      "destination": "https://link.curivanta.com/widget/:path*",
      "permanent": false
    },
    {
      "source": "/home-preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hair-salon-bot",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/reviewautomation",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/website-development",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hair-salon-bot/welcome",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/reviewautomation/welcome",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/new",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/solar",
      "destination": "/solar/index.html"
    },
    {
      "source": "/solar/privacy",
      "destination": "/solar/privacy/index.html"
    },
    {
      "source": "/solar/review",
      "destination": "/solar/review/index.html"
    },
    {
      "source": "/solar/report/:id",
      "destination": "/solar/review/index.html"
    },
    {
      "source": "/solar/full-review/thanks",
      "destination": "/solar/full-review/thanks/index.html"
    },
    {
      "source": "/solar/guides",
      "destination": "/solar/guides/index.html"
    },
    {
      "source": "/solar/guides/:slug",
      "destination": "/solar/guides/:slug/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/square",
      "destination": "/square/index.html"
    },
    {
      "source": "/salonultimate",
      "destination": "/salonultimate/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/roi",
      "destination": "/roi/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/story",
      "destination": "/story/index.html"
    },
    {
      "source": "/missed-calls",
      "destination": "/missed-calls/index.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews/index.html"
    },
    {
      "source": "/phone",
      "destination": "/phone/index.html"
    },
    {
      "source": "/owner-app",
      "destination": "/owner-app/index.html"
    },
    {
      "source": "/salons",
      "destination": "/salons/index.html"
    },
    {
      "source": "/solo",
      "destination": "/solo/index.html"
    },
    {
      "source": "/locations",
      "destination": "/locations/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/((?!solar/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/solar",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/solar/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/solar/report/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/solar/full-review/thanks",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
