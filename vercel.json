{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/book",
      "destination": "https://link.curivanta.com/widget/bookings/solar-consulting-calendar",
      "permanent": false
    },
    {
      "source": "/widget/:path*",
      "destination": "https://link.curivanta.com/widget/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/solar",
      "destination": "/solar/index.html"
    },
    {
      "source": "/solar/review",
      "destination": "/solar/review/index.html"
    },
    {
      "source": "/solar/report/:id",
      "destination": "/solar/review/index.html"
    },
    {
      "source": "/solar/full-review/thanks",
      "destination": "/solar/full-review/thanks/index.html"
    },
    {
      "source": "/((?!solar/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/solar/report/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/solar/full-review/thanks",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
